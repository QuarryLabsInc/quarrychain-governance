# Data source. "mock" ships standalone with simulated telemetry.
# "live" requires a DataProvider implementation — see docs/integration.md.
NEXT_PUBLIC_DATA_MODE=mock

# Public QuarryChain testnet EVM JSON-RPC (chain-id 1129).
# Used today for the onboarding node probe and, in live mode, block height.
NEXT_PUBLIC_QUARRYCHAIN_RPC_URL=https://rpc.testnet.quarrychain.network

# Blockscout explorer base URL, for address/block deep links.
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.quarrychain.network

# Comma-separated admin wallet addresses that unlock the QuarryLabs console.
# NOTE: this is a UI convenience only. Real authorization MUST be enforced
# server-side — hiding a button is not access control.
NEXT_PUBLIC_ADMIN_WALLETS=

# WalletConnect project ID (Phase 6, wallet connect). Free at cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Supabase validator profile store (chain = source of truth; Supabase mirrors
# it + holds logo / peer ID / RPC / host). Browser-safe values only:
# the publishable key can only READ (RLS). Never put the secret/service_role
# key here — it belongs to the Edge Functions alone.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
